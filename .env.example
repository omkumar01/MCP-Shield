# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ MCP-Shield Environment Configuration Template                                │
# │                                                                              │
# │ Copy this file to .env and customize for your environment:                  │
# │   cp .env.example .env                                                      │
# │                                                                              │
# │ NEVER commit .env to version control!                                       │
# └──────────────────────────────────────────────────────────────────────────────┘

# ─────────────────────────────────────────────────────────────────────────────
# Build Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Build metadata (auto-populated in CI)
BUILD_DATE=2024-01-01T00:00:00Z
BUILD_VERSION=dev
VCS_REF=local
VCS_URL=https://github.com/mcp-shield/mcp-shield

# Image tags
MCP_SHIELD_IMAGE=mcpshield/mcp-shield:dev
MCP_ECHO_IMAGE=mcpshield/mcp-echo:dev

# ─────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error
MCP_SHIELD_LOG_LEVEL=debug

# Enable/disable features
MCP_SHIELD_AUTH_ENABLED=false
MCP_SHIELD_DB_ENABLED=true
MCP_SHIELD_REDIS_ENABLED=true
MCP_SHIELD_DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# Authentication (Production: Use Secrets!)
# ─────────────────────────────────────────────────────────────────────────────
# JWT Secret (HMAC) - MUST be changed in production!
# Generate with: openssl rand -base64 32
MCP_SHIELD_AUTH_JWT_SECRET=dev-secret-change-in-production-min-32-chars

# JWKS URL for key rotation (alternative to JWT_SECRET)
# MCP_SHIELD_AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# OIDC Issuer URL
MCP_SHIELD_AUTH_ISSUER=https://auth.local

# Required OAuth scopes
MCP_SHIELD_AUTH_REQUIRED_SCOPES=mcp:tools:read,mcp:tools:call

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=mcp_shield
POSTGRES_USER=mcp_shield
POSTGRES_PASSWORD=changeme

# Connection string (used by MCP-Shield)
MCP_SHIELD_DB_URL=postgresql://mcp_shield:changeme@postgres:5432/mcp_shield?sslmode=disable

# Connection pool settings
MCP_SHIELD_DB_MAX_CONNECTIONS=20
MCP_SHIELD_DB_MIN_CONNECTIONS=5
MCP_SHIELD_DB_CONNECT_TIMEOUT=30
MCP_SHIELD_DB_IDLE_TIMEOUT=600
MCP_SHIELD_DB_MAX_LIFETIME=1800

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# Connection string (used by MCP-Shield)
MCP_SHIELD_REDIS_URL=redis://:changeme@redis:6379/0

# Redis settings
MCP_SHIELD_REDIS_MAX_CONNECTIONS=50
MCP_SHIELD_REDIS_CONNECT_TIMEOUT=10
MCP_SHIELD_REDIS_COMMAND_TIMEOUT=5

# ─────────────────────────────────────────────────────────────────────────────
# Upstream MCP Servers
# ─────────────────────────────────────────────────────────────────────────────
# Default upstream for development (echo server)
MCP_SHIELD_PROXY_UPSTREAM_URL=http://mcp-echo:8080

# Production upstreams (comma-separated)
# MCP_SHIELD_PROXY_UPSTREAM_URLS=https://mcp1.example.com,https://mcp2.example.com

# Proxy settings
MCP_SHIELD_PROXY_REQUEST_TIMEOUT_SECS=30
MCP_SHIELD_PROXY_MAX_CONCURRENT=100
MCP_SHIELD_PROXY_TLS_VERIFY=true

# ─────────────────────────────────────────────────────────────────────────────
# Tool Registry
# ─────────────────────────────────────────────────────────────────────────────
MCP_SHIELD_REGISTRY_ENFORCE_PREFIX=true
MCP_SHIELD_REGISTRY_ALLOWED_PREFIXES=com.local,io.local

# ─────────────────────────────────────────────────────────────────────────────
# Telemetry & Observability
# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry
OTEL_SERVICE_NAME=mcp-shield
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=service.name=mcp-shield,deployment.environment=local

# Metrics
MCP_SHIELD_TELEMETRY_METRICS_PATH=/metrics
MCP_SHIELD_TELEMETRY_METRICS_ADDR=0.0.0.0:9090

# Kafka (Phase 2 - Audit Pipeline)
MCP_SHIELD_TELEMETRY_KAFKA_BOOTSTRAP_SERVERS=
MCP_SHIELD_TELEMETRY_KAFKA_TOPIC=mcp-shield-audit

# ─────────────────────────────────────────────────────────────────────────────
# TLS/SSL Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Path to TLS certificate (for production HTTPS)
# MCP_SHIELD_TLS_CERT_FILE=/etc/mcp-shield/tls/tls.crt
# MCP_SHIELD_TLS_KEY_FILE=/etc/mcp-shield/tls/tls.key
# MCP_SHIELD_TLS_CA_FILE=/etc/mcp-shield/tls/ca.crt

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags (Phase 2+)
# ─────────────────────────────────────────────────────────────────────────────
# Cedar Policy Engine
MCP_SHIELD_CEDAR_ENABLED=false
MCP_SHIELD_CEDAR_POLICY_DIR=/etc/mcp-shield/policies

# Session Context Locking (Anti-Prompt Injection)
MCP_SHIELD_SESSION_LOCKING_ENABLED=false

# ePCA Symbolic Guardrails
MCP_SHIELD_ECPA_ENABLED=false

# Egress Sanitization
MCP_SHIELD_EGRESS_SANITIZATION_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
MCP_SHIELD_RATE_LIMIT_ENABLED=false
MCP_SHIELD_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
MCP_SHIELD_RATE_LIMIT_BURST=100

# ─────────────────────────────────────────────────────────────────────────────
# CORS Configuration
# ─────────────────────────────────────────────────────────────────────────────
MCP_SHIELD_CORS_ENABLED=true
MCP_SHIELD_CORS_ALLOWED_ORIGINS=*
MCP_SHIELD_CORS_ALLOWED_METHODS=GET,POST,OPTIONS
MCP_SHIELD_CORS_ALLOWED_HEADERS=Content-Type,Authorization,Mcp-Session-Id
MCP_SHIELD_CORS_MAX_AGE=86400

# ─────────────────────────────────────────────────────────────────────────────
# Development Tools
# ─────────────────────────────────────────────────────────────────────────────
# Enable development profiles
COMPOSE_PROFILES=dev-tools